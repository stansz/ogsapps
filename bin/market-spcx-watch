#!/bin/bash
# market-spcx-watch — SPCX IPO rebalance impact tracker
# Tracks QQQ forced-sell impact on watchlist + bottom-tier dip targets
# Uses Finnhub for live prices (60 calls/min free) + hardcoded QQQ weights
#
# Budget: 22 Finnhub quote calls per run — well within free tier (60/min)

set -euo pipefail
source /opt/data/.env

FH_KEY="${FINNHUB_KEY:-}"
if [ -z "$FH_KEY" ]; then
  echo "FINNHUB_KEY not set"
  exit 1
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# ── QQQ weights (approximate, as of May 2026) ──
declare -A QQQ_WEIGHT
QQQ_WEIGHT[NVDA]=8.3
QQQ_WEIGHT[AAPL]=7.3
QQQ_WEIGHT[META]=3.0
QQQ_WEIGHT[AMD]=3.6
QQQ_WEIGHT[TSM]=1.0
QQQ_WEIGHT[INTC]=2.7
QQQ_WEIGHT[GILD]=0.74
QQQ_WEIGHT[MRNA]=0.3
QQQ_WEIGHT[BIIB]=0.3
QQQ_WEIGHT[MCHP]=0.23
QQQ_WEIGHT[ON]=0.4
QQQ_WEIGHT[MDLZ]=0.35
QQQ_WEIGHT[KHC]=0.13
QQQ_WEIGHT[PEP]=0.90
QQQ_WEIGHT[ALNY]=0.17
QQQ_WEIGHT[INSM]=0.10
QQQ_WEIGHT[DXCM]=0.12
QQQ_WEIGHT[ARM]=0.19
QQQ_WEIGHT[REGN]=0.29
QQQ_WEIGHT[VRTX]=0.49

# ── Catalyst calendar ──
declare -A CATALYST
CATALYST[GILD]="🔥 HIV BIC/LEN PDUFA (priority review) — Aug 27"
CATALYST[MRNA]="🔥 Flu vaccine PDUFA (27% better efficacy) — Aug 5"
CATALYST[BIIB]="Tau Alzheimer's Phase 3 — Q3 2026"
CATALYST[ALNY]="⚡ Amvuttra ATTR-CM data; vutrisiran label expansion — H2 2026"
CATALYST[INSM]="⚡ Arikayce label expansion; brensocatib revenue ramp (approved Apr 2026)"
CATALYST[DXCM]="⚡ Stelo OTC CGM rollout; growing T2D market; potential M&A target"
CATALYST[ARM]="⚡ AI/edge chip IP royalties; licensing growth; earnings catalyst Q3 2026"
CATALYST[MCHP]="Semi cycle recovery play; forced sell dip entry — H2 2026"
CATALYST[REGN]="🔥 Down 22% (fianlimab miss), 4 FDA approvals in 2026; Dupixent COPD ramp; Factor XI Ph3"
CATALYST[VRTX]="🔥 DPN Ph3 data H2 2026 (\$5B pain market); Journavx approved acute pain; global expansion"

# ── All tickers ──
WATCHLIST=($(/opt/data/workspace/bin/market-symbols equities))
BOTTOM_TIER=(GILD MRNA BIIB MCHP ON MDLZ KHC PEP ALNY INSM DXCM ARM REGN VRTX)
ALL_TICKERS=("${WATCHLIST[@]}" "${BOTTOM_TIER[@]}")

echo "SPCX_WATCH: $(TZ='America/Vancouver' date '+%Y-%m-%d %H:%M %Z')"
echo ""

# ── Fetch Finnhub quotes for all tickers ──
for sym in "${ALL_TICKERS[@]}"; do
  curl -sf --max-time 10 \
    "https://finnhub.io/api/v1/quote?symbol=${sym}&token=${FH_KEY}" \
    -o "${TMPDIR}/${sym}.json" 2>/dev/null
  sleep 0.3
done

# ── Analyze ──
export TMPDIR
export WATCHLIST_STR="${WATCHLIST[*]}"
export BOTTOM_TIER_STR="${BOTTOM_TIER[*]}"

python3 << 'PYEOF'
import json, os

tmpdir = os.environ.get('TMPDIR', '/tmp')
watchlist = os.environ.get('WATCHLIST_STR', '').split()
bottom_tier = os.environ.get('BOTTOM_TIER_STR', '').split()
all_tickers = watchlist + bottom_tier

QQQ_WEIGHT = {
    'NVDA': 8.3, 'AAPL': 7.3, 'META': 3.0, 'AMD': 3.6,
    'TSM': 1.0, 'INTC': 2.7, 'GILD': 0.74, 'MRNA': 0.3,
    'BIIB': 0.3, 'MCHP': 0.23, 'ON': 0.4, 'MDLZ': 0.35,
    'KHC': 0.13, 'PEP': 0.90, 'ALNY': 0.17, 'INSM': 0.10,
    'DXCM': 0.12, 'ARM': 0.19, 'REGN': 0.29, 'VRTX': 0.49
}

CATALYST = {
    'GILD': '🔥 HIV BIC/LEN PDUFA (priority review) — Aug 27',
    'MRNA': '🔥 Flu vaccine PDUFA (27% better efficacy) — Aug 5',
    'BIIB': 'Tau Alzheimer\'s Phase 3 — Q3 2026',
    'ALNY': '⚡ Amvuttra ATTR-CM data; vutrisiran expansion — H2 2026',
    'INSM': '⚡ Arikayce expansion; brensocatib ramp (approved Apr 2026)',
    'DXCM': '⚡ Stelo OTC CGM; growing T2D market; M&A target',
    'ARM': '⚡ AI/edge chip IP royalties; licensing growth — Q3 2026',
    'MCHP': 'Semi cycle recovery; forced sell dip entry — H2 2026',
    'REGN': '🔥 Down 22% (fianlimab miss), 4 FDA approvals 2026; Dupixent COPD; Factor XI Ph3',
    'VRTX': '🔥 DPN Ph3 data H2 2026 ($5B pain market); Journavx approved; global expansion'
}

def parse_quote(fpath):
    try:
        d = json.load(open(fpath))
    except:
        return None
    c = d.get('c', 0)
    if c == 0:
        return None
    return {
        'price': float(c),
        'change': float(d.get('d', 0)),
        'change_pct': float(d.get('dp', 0)),
        'high': float(d.get('h', 0)),
        'low': float(d.get('l', 0)),
        'prev_close': float(d.get('pc', 0))
    }

results = []
for sym in all_tickers:
    q = parse_quote(f"{tmpdir}/{sym}.json")
    if q is None:
        continue
    
    q['ticker'] = sym
    q['qqq_weight'] = QQQ_WEIGHT.get(sym, 0)
    q['catalyst'] = CATALYST.get(sym, '')
    q['in_watchlist'] = sym in watchlist
    results.append(q)

wl = [r for r in results if r['in_watchlist']]
bt = [r for r in results if not r['in_watchlist']]

# ── Output ──
print("## 🚀 SPCX REBALANCE WATCH")
print("")
print(f"**Timeline:** ~July 6-7, 2026 — Nasdaq-100 Fast Entry adds SPCX after 15 trading days.")
print(f"**Mechanism:** Passive funds (QQQ/SPY/IWM) must mechanically sell existing QQQ holdings")
print(f"to raise cash for SPCX. Goldman estimates ~$95B in forced selling. Index math, not fundamentals.")
print("")

# ── Watchlist Impact ──
print("### 📊 YOUR WATCHLIST — LIVE QQQ IMPACT")
print("")
print("| Ticker | Price | Chg% | QQQ Wt | Est. Forced Sell | Dip Effect |")
print("|--------|-------|------|--------|------------------|------------|")
for r in sorted(wl, key=lambda x: x['qqq_weight'], reverse=True):
    w = r['qqq_weight']
    chg = f"{r['change_pct']:+.1f}%" if r['change_pct'] != 0 else "—"
    
    if w >= 2.0:
        est_sell = f"~{w * 0.6:.1f}% position"
        dip = f"⚠️ {3 + w * 0.2:.0f}-{3 + w * 0.5:.0f}% dip"
    elif w > 0.5:
        est_sell = f"~{w * 0.6:.1f}% position"
        dip = "1-3% dip"
    else:
        est_sell = "Minimal"
        dip = "Negligible"
    
    print(f"| **{r['ticker']}** | ${r['price']:.2f} | {chg} | ~{w:.0f}% | {est_sell} | {dip} |")

print("")

# ── Bottom-tier ──
print("### 🎯 BOTTOM-TIER DIP CANDIDATES (with catalysts)")
print("")
print("| Ticker | Price | Chg% | QQQ Wt | Est. Dip | Catalyst |")
print("|--------|-------|------|--------|----------|----------|")

for r in sorted(bt, key=lambda x: x['qqq_weight'], reverse=True):
    chg = f"{r['change_pct']:+.1f}%" if r['change_pct'] != 0 else "—"
    w = r['qqq_weight']
    dip = "3-7%" if w >= 0.4 else "4-8%"
    cat = r['catalyst'] if r['catalyst'] else "—"
    print(f"| **{r['ticker']}** | ${r['price']:.2f} | {chg} | ~{w:.1f}% | {dip} | {cat} |")

print("")
print("**🥇 REGN** — down 22%, 4 FDA approvals in 2026, most asymmetric squeeze. Triple catalyst.")
print("**🥈 VRTX** — DPN Ph3 data ($5B market). Biggest pharma catalyst in Nasdaq-100.")
print("**🥉 GILD** — buy dip, hold 7 weeks to HIV PDUFA (Aug 27). Calendar arbitrage.")
print("**4. ALNY** — ATTR-CM data, ultra-low weight (0.17%). Highest % squeeze impact.")
print("**5. INSM** — smallest QQQ position (0.10%), most elastic. Brensocatib revenue.")
print("**6. DXCM** — OTC CGM rollout, T2D market 20%+ YoY. Device M&A target.")
print("**7. ARM** — AI semiconductor IP, low float. Magnified rebalance moves.")
print("**8. MCHP** — semi cycle recovery. Buy forced dip, hold to H2 recovery.")
print("")
print("**Strategy:** Mark ~July 1-11. Buy red days with no earnings. Hold 1-2 weeks post-rebalance.")
print("Calendar trades (GILD, MRNA): hold through FDA decision for binary payoff.")
PYEOF

exit $?
