#!/bin/bash
# market-spcx-watch — SPCX IPO rebalance impact tracker
# Tracks QQQ forced-sell impact on watchlist + bottom-tier dip targets
# Output: formatted markdown report for the LLM or direct delivery
#
# Uses AlphaVantage OVERVIEW + GLOBAL_QUOTE for current prices
# Budget: ~16 OVERVIEW calls (watchlist + bottom-tier) + 1 QUOTE each

set -euo pipefail
source /opt/data/.env

AV_KEY="${ALPHA_VANTAGE_API:-}"
if [ -z "$AV_KEY" ]; then
  echo "ALPHA_VANTAGE_API not set"
  exit 1
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# ── QQQ weights (approximate, as of May 2026) ──
declare -A QQQ_WEIGHT
QQQ_WEIGHT[NVDA]=8.0
QQQ_WEIGHT[AAPL]=7.0
QQQ_WEIGHT[META]=5.0
QQQ_WEIGHT[AMD]=2.0
QQQ_WEIGHT[TSM]=1.0
QQQ_WEIGHT[INTC]=0.5
QQQ_WEIGHT[GILD]=0.4
QQQ_WEIGHT[MRNA]=0.3
QQQ_WEIGHT[BIIB]=0.3
QQQ_WEIGHT[MCHP]=0.3
QQQ_WEIGHT[ON]=0.4
QQQ_WEIGHT[MDLZ]=0.5
QQQ_WEIGHT[KHC]=0.4
QQQ_WEIGHT[PEP]=0.5

# ── Bottom-tier catalyst calendar ──
declare -A CATALYST
CATALYST[GILD]="HIV BIC/LEN PDUFA (priority review) | Aug 27"
CATALYST[MRNA]="Flu vaccine PDUFA (27% better efficacy) | Aug 5"
CATALYST[BIIB]="Tau Alzheimer's Phase 3 | Q3 2026"

# ── All tickers to track ──
WATCHLIST=($(/opt/data/workspace/bin/market-symbols equities))
BOTTOM_TIER=(GILD MRNA BIIB MCHP ON MDLZ KHC PEP)
ALL_TICKERS=("${WATCHLIST[@]}" "${BOTTOM_TIER[@]}")

echo "SPCX_WATCH: $(TZ='America/Vancouver' date '+%Y-%m-%d %H:%M %Z')"
echo ""

# ── Fetch OVERVIEW for all tickers ──
for sym in "${ALL_TICKERS[@]}"; do
  curl -sf --max-time 15 \
    "https://www.alphavantage.co/query?function=OVERVIEW&symbol=${sym}&apikey=${AV_KEY}" \
    -o "${TMPDIR}/${sym}.json" 2>/dev/null
  sleep 1
done

# ── Analyze ──
export TMPDIR
export WATCHLIST_STR="${WATCHLIST[*]}"
export BOTTOM_TIER_STR="${BOTTOM_TIER[*]}"

python3 << 'PYEOF'
import json, os

tmpdir = os.environ.get('TMPDIR', '/tmp')
watchlist = os.environ.get('WATCHLIST_STR', '').split()
bottom_tier = os.environ.get('BOTTOM_TIER_STR', '').split()
all_tickers = watchlist + bottom_tier

QQQ_WEIGHT = {
    'NVDA': 8.0, 'AAPL': 7.0, 'META': 5.0, 'AMD': 2.0,
    'TSM': 1.0, 'INTC': 0.5, 'GILD': 0.4, 'MRNA': 0.3,
    'BIIB': 0.3, 'MCHP': 0.3, 'ON': 0.4, 'MDLZ': 0.5,
    'KHC': 0.4, 'PEP': 0.5
}

CATALYST = {
    'GILD': 'HIV BIC/LEN PDUFA (priority review) | Aug 27',
    'MRNA': 'Flu vaccine PDUFA (27% better efficacy) | Aug 5',
    'BIIB': 'Tau Alzheimer\'s Phase 3 | Q3 2026'
}

def parse_overview(fpath):
    try:
        d = json.load(open(fpath))
    except:
        return None
    if 'Information' in d or 'Symbol' not in d:
        return None
    try:
        ma50 = float(d.get('50DayMovingAverage', 0) or 0)
        w52h = float(d.get('52WeekHigh', 0) or 0)
        w52l = float(d.get('52WeekLow', 0) or 0)
        # Use MA50 as price proxy (same as lotto scanner)
        price = ma50 if ma50 > 0 else (w52h + w52l) / 2
        return {
            'name': d.get('Name', '?'),
            'price': price,
            'ma50': ma50,
            'ma200': float(d.get('200DayMovingAverage', 0) or 0),
            'w52h': w52h,
            'w52l': w52l,
            'beta': float(d.get('Beta', 0) or 0),
            'target': float(d.get('AnalystTargetPrice', 0) or 0),
            'sector': d.get('Sector', '?'),
            'mkt_cap': float(d.get('MarketCapitalization', 0) or 0) / 1e9,
            'pe': float(d.get('PERatio', 0) or 0),
            'name_full': d.get('Name', sym)
        }
    except (ValueError, TypeError):
        return None

# Collect data
results = []
for sym in all_tickers:
    ov = parse_overview(f"{tmpdir}/{sym}.json")
    if ov is None:
        continue
    
    ov['ticker'] = sym
    ov['qqq_weight'] = QQQ_WEIGHT.get(sym, 0)
    ov['in_watchlist'] = sym in watchlist
    ov['catalyst'] = CATALYST.get(sym, '')
    results.append(ov)

# Split into watchlist and bottom-tier
wl = [r for r in results if r['in_watchlist']]
bt = [r for r in results if not r['in_watchlist']]

# ── Output ──
print("## 🚀 SPCX REBALANCE WATCH")
print("")
print(f"**Timeline:** ~July 6-7, 2026 — Nasdaq-100 Fast Entry adds SPCX after 15 trading days.")
print(f"**Mechanism:** Passive funds (QQQ/SPY/IWM) must mechanically sell existing QQQ holdings")
print(f"to raise cash for SPCX. Goldman estimates ~$95B in forced selling. Index math, not fundamentals.")
print("")

# ── Watchlist Impact ──
print("### 📊 YOUR WATCHLIST — QQQ FORCED SELL IMPACT")
print("")
print("| Ticker | Price | QQQ Wt | Est. Sell | 50MA | 200MA | Beta | Target |")
print("|--------|-------|--------|-----------|------|-------|------|--------|")
buy_targets = []
for r in sorted(wl, key=lambda x: x['qqq_weight'], reverse=True):
    w = r['qqq_weight']
    if w > 0.5:
        est_sell = f"{w * 0.6:.1f}% of position"
        impact = f"⚠️ ~{est_sell}"
        buy_targets.append(r)
    else:
        impact = "Minimal"
    
    price_str = f"${r['price']:.2f}" if r['price'] > 0 else "?"
    ma50_str = f"${r['ma50']:.2f}" if r['ma50'] > 0 else "?"
    ma200_str = f"${r['ma200']:.2f}" if r['ma200'] > 0 else "?"
    target_str = f"${r['target']:.2f}" if r['target'] > 0 else "?"
    
    print(f"| **{r['ticker']}** | {price_str} | ~{w:.0f}% | {impact} | {ma50_str} | {ma200_str} | {r['beta']:.1f} | {target_str} |")

if buy_targets:
    print("")
    print("**🎯 Buy targets on the rebalance dip:** ", end="")
    print(", ".join(f"{r['ticker']} (est +{((r['target']-r['price'])/r['price']*100):.0f}% upside)" for r in buy_targets if r['target'] > r['price']))

print("")
print("### 🎯 BOTTOM-TIER DIP CANDIDATES")
print("")
print("Low-weight QQQ stocks with thin liquidity. Small forced sells can gap them 5-8%.")
print("| Ticker | Price | QQQ Wt | Est Dip | Sector | 🧬 Catalyst |")
print("|--------|-------|--------|---------|--------|-------------|")

for r in sorted(bt, key=lambda x: x['qqq_weight'], reverse=True):
    w = r['qqq_weight']
    if w >= 0.4:
        est_dip = "3-7%"
    else:
        est_dip = "4-8%"
    
    price_str = f"${r['price']:.2f}" if r['price'] > 0 else "?"
    cat = r['catalyst'] if r['catalyst'] else "—"
    
    print(f"| **{r['ticker']}** | {price_str} | ~{w:.1f}% | {est_dip} | {r['sector']} | {cat} |")

print("")
print("**Strategy:** Mark ~July 1-11 on the calendar. Buy the red days with no earnings/news.")
print("Hold 1-2 weeks post-rebalance for the snap-back. Not short candidates — borrow costs spike.")
print("")
print("**🥇 GILD is the best setup:** SPCX forced-sell entry (~July 7) → 7 weeks → FDA decision (Aug 27).")
print("Calendar arbitrage — buy the dip, sell the approval pop.")
PYEOF

exit $?
