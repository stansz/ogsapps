#!/bin/bash
# market-lotto — Lottery ticket scanner for watchlist stocks
# Uses AlphaVantage OVERVIEW data + existing sentiment data
# Output: ranked LOTTO scores for the LLM
#
# Budget: 8 OVERVIEW calls (weekly scan, not daily)

set -euo pipefail
source /opt/data/.env

AV_KEY="${ALPHA_VANTAGE_API:-}"
if [ -z "$AV_KEY" ]; then
  echo "ALPHA_VANTAGE_API not set"
  exit 1
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

SYMBOLS=($(/opt/data/workspace/bin/market-symbols equities))

echo "LOTTO_SCAN: $(TZ='America/Vancouver' date '+%Y-%m-%d %H:%M %Z')"
echo ""

# ── Fetch OVERVIEW for all tickers (sequential, free tier 1/sec) ──
for sym in "${SYMBOLS[@]}"; do
  curl -sf --max-time 15 \
    "https://www.alphavantage.co/query?function=OVERVIEW&symbol=${sym}&apikey=${AV_KEY}" \
    -o "${TMPDIR}/${sym}.json" 2>/dev/null
  sleep 1
done

# ── Score & rank ──
export SYMBOLS_STR="${SYMBOLS[*]}"
export TMPDIR
python3 << 'PYEOF'
import json, os, sys

symbols = os.environ.get('SYMBOLS_STR', '').split()
tmpdir = os.environ.get('TMPDIR', '/tmp')

results = []

for sym in symbols:
    fpath = f"{tmpdir}/{sym}.json"
    if not os.path.exists(fpath) or os.path.getsize(fpath) < 100:
        continue
    
    try:
        d = json.load(open(fpath))
    except:
        continue
    
    # Skip if rate-limited
    if 'Information' in d:
        continue
    
    # Extract values
    try:
        price = float(d.get('AnalystTargetPrice', 0) or 0)  # fallback: we need current price
        # Actually: OVERVIEW doesn't have current price. Use 50DayMA as proxy.
        ma50 = float(d.get('50DayMovingAverage', 0) or 0)
        ma200 = float(d.get('200DayMovingAverage', 0) or 0)
        w52h = float(d.get('52WeekHigh', 0) or 0)
        w52l = float(d.get('52WeekLow', 0) or 0)
        beta = float(d.get('Beta', 0) or 0)
        target = float(d.get('AnalystTargetPrice', 0) or 0)
        name = d.get('Name', sym)
        sector = d.get('Sector', '?')
        market_cap = float(d.get('MarketCapitalization', 0) or 0)
        pe = float(d.get('PERatio', 0) or 0)
        eps = float(d.get('EPS', 0) or 0)
        profit_margin = float(d.get('ProfitMargin', 0) or 0)
        rev_growth = float(d.get('QuarterlyRevenueGrowthYOY', 0) or 0)
        earn_growth = float(d.get('QuarterlyEarningsGrowthYOY', 0) or 0)
    except (ValueError, TypeError):
        continue
    
    if w52h <= 0 or w52l <= 0:
        continue
    
    # Estimate current price: use 50-day MA as rough proxy
    est_price = ma50 if ma50 > 0 else (w52h + w52l) / 2
    if est_price <= 0:
        continue
    
    # ── Score components (0-1 scale) ──
    
    # 1. Proximity to 52W low (closer = more bounce potential = more lottery)
    range_52w = w52h - w52l
    if range_52w > 0:
        pct_off_low = (est_price - w52l) / range_52w  # 0 = at low, 1 = at high
        low_proximity = 1.0 - pct_off_low  # invert: 1 = at bottom
    else:
        low_proximity = 0.5
    
    # 2. Below 50-day MA? (below = potential mean reversion bounce)
    if ma50 > 0:
        below_ma = 1.0 if est_price < ma50 else 0.3  # binary with floor
    else:
        below_ma = 0.5
    
    # 3. Below 200-day MA? (deeper bearish signal — interesting bounce candidate)
    if ma200 > 0:
        below_200 = 1.0 if est_price < ma200 else 0.2
    else:
        below_200 = 0.5
    
    # 4. Beta (higher = more volatile = more lottery-like, but cap at reasonable level)
    beta_score = min(beta / 3.0, 1.0) if beta > 0 else 0.5
    
    # 5. Analyst upside (how far below target — potential catalyst)
    if target > 0 and est_price > 0:
        upside = (target - est_price) / est_price
        upside_score = max(min(upside * 100 / 50, 1.0), 0.0)  # 50% upside = max score
    else:
        upside_score = 0.0
    
    # 6. Growth check (even lotto tickets should have some growth story)
    growth_present = 0.5 if (rev_growth > 0 or earn_growth > 0) else 0.0
    
    # ── Composite LOTTO score ──
    lotto = (
        low_proximity * 0.30 +
        below_ma * 0.20 +
        below_200 * 0.10 +
        beta_score * 0.10 +
        upside_score * 0.15 +
        growth_present * 0.15
    )
    
    # ── Summary flags ──
    flags = []
    if pct_off_low < 0.15:
        flags.append("🔥 NEAR 52W LOW")
    if est_price < ma50 and ma50 > 0:
        flags.append("📉 BELOW 50MA")
    if est_price < ma200 and ma200 > 0:
        flags.append("📉 BELOW 200MA")
    if beta > 2:
        flags.append(f"🎢 BETA {beta:.1f}")
    if target > est_price * 1.2 and target > 0:
        flags.append(f"🎯 {((target-est_price)/est_price*100):.0f}% UPSIDE")
    if rev_growth > 0.1:
        flags.append(f"📈 REV +{rev_growth*100:.0f}%")
    if earn_growth > 0.1:
        flags.append(f"💰 EPS +{earn_growth*100:.0f}%")
    
    # Store SPCX risk for later section (don't clutter flags)
    QQQ_HIGH_WEIGHT = {'NVDA': 0.08, 'AAPL': 0.07, 'META': 0.05, 'AMD': 0.02, 'TSM': 0.01, 'INTC': 0.005}
    spcx_weight = QQQ_HIGH_WEIGHT.get(sym, 0)
    
    results.append({
        'ticker': sym,
        'name': name,
        'lotto': round(lotto, 3),
        'est_price': round(est_price, 2),
        'w52h': w52h,
        'w52l': w52l,
        'pct_off_low': round(pct_off_low * 100, 1),
        'ma50': ma50,
        'ma200': ma200,
        'beta': round(beta, 2),
        'target': target,
        'sector': sector,
        'market_cap': market_cap,
        'pe': round(pe, 2) if pe else 0,
        'rev_growth': round(rev_growth * 100, 1),
        'earn_growth': round(earn_growth * 100, 1),
        'spcx_weight': round(spcx_weight * 100, 1),
        'flags': ' '.join(flags) if flags else '—'
    })

# Sort by LOTTO score descending
results.sort(key=lambda x: x['lotto'], reverse=True)

# ── Output ──
print("## LOTTERY TICKETS (weekly scan)")
print("")
print(f"| Rank | Ticker | Score | Price | 52W Range | Beta | Flags |")
print(f"|------|--------|-------|-------|-----------|------|-------|")
for i, r in enumerate(results, 1):
    range_str = f"\${r['w52l']}–\${r['w52h']}"
    price_str = f"\${r['est_price']}" if r['est_price'] > 0 else "?"
    print(f"| {i} | **{r['ticker']}** | {r['lotto']:.3f} | {price_str} | {range_str} | {r['beta']} | {r['flags']} |")

print("")
print("## DETAILS")
print("")
for r in results:
    print(f"**{r['ticker']}** ({r['name']}, {r['sector']})")
    print(f"  LOTTO: {r['lotto']:.3f} | Est Price: \${r['est_price']} | {r['pct_off_low']}% off 52W low")
    print(f"  50MA: \${r['ma50']} | 200MA: \${r['ma200']} | Beta: {r['beta']} | P/E: {r['pe']}")
    print(f"  Rev Growth: {r['rev_growth']}% | EPS Growth: {r['earn_growth']}%")
    print(f"  Flags: {r['flags']}")
    print("")

PYEOF

exit $?
