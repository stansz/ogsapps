#!/bin/bash
# ai-news-fetch — Fetches AI/ML news from RSS feeds for LLM briefing
# Sources: arXiv papers, MarkTechPost, TechCrunch AI, AI News
#
# Budget: 6 RSS calls + 3 Browserbase Search (optional, only if BROWSERBASE_API_KEY set)

set -euo pipefail

source /opt/data/.env 2>/dev/null || true

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

MODE="${1:-brief}"  # brief (3 days) or week (7 days)
DAYS=3
if [ "$MODE" = "week" ]; then DAYS=7; fi

CUTOFF=$(date -d "$DAYS days ago" +%s 2>/dev/null || python3 -c "import time; print(int(time.time()) - $DAYS*86400)")

# ── All feeds are verified working RSS XML ──
declare -A FEEDS
FEEDS["https://rss.arxiv.org/rss/cs.CL"]="arXiv|cs.CL"
FEEDS["https://rss.arxiv.org/rss/cs.AI"]="arXiv|cs.AI"
FEEDS["https://rss.arxiv.org/rss/cs.LG"]="arXiv|cs.LG"
FEEDS["https://www.marktechpost.com/feed/"]="MarkTechPost"
FEEDS["https://techcrunch.com/category/artificial-intelligence/feed/"]="TechCrunch"
FEEDS["https://www.artificialintelligence-news.com/feed/"]="AI News"

export CUTOFF TMPDIR

# Collect raw pipe-delimited items
RAWFILE="${TMPDIR}/raw_items.txt"
> "$RAWFILE"

for url in "${!FEEDS[@]}"; do
  name="${FEEDS[$url]}"
  
  xmlfile="${TMPDIR}/feed.xml"
  curl -sf --max-time 15 "$url" -o "$xmlfile" 2>/dev/null || continue
  
  python3 -c "
import sys, re, html
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
from xml.etree import ElementTree as ET

cutoff = int('$CUTOFF')
name = '$name'

try:
    tree = ET.parse('$xmlfile')
    root = tree.getroot()
except Exception as e:
    sys.exit(0)

items = root.findall('.//item')
if not items:
    ns = {'atom': 'http://www.w3.org/2005/Atom'}
    items = root.findall('.//atom:entry', ns)

# arXiv keyword filter (keep only LLM/agent/transformer papers)
ARXIV_KW = [
    'llm', 'language model', 'large language', 'transformer', 'agent',
    'reasoning', 'alignment', 'rlhf', 'fine-tun', 'pretrain',
    'multimodal', 'retrieval', 'rag', 'benchmark', 'safety', 'jailbreak',
    'mixture of expert', 'moe', 'chain.of.thought', 'cot',
    'instruction', 'reinforcement learning', 'open.source', 'open-weight',
    'distill', 'quantiz', 'scaling law', 'emergen', 'in-context',
    'prompt', 'few-shot', 'zero-shot', 'diffusion', 'gpt', 'claude',
    'gemini', 'llama', 'deepseek', 'qwen', 'mistral', 'grok',
    'code generation', 'tool use', 'function call', 'planning',
    'synthetic data', 'data curation', 'evaluation', 'reward model',
    'self-play', 'tree.of.thought', 'test.time', 'compute optimal'
]

is_arxiv = 'arxiv' in name.lower()

count = 0
for item in items:
    title = item.findtext('title', '') or ''
    link = item.findtext('link', '') or ''
    
    # Handle Atom links
    if not link:
        for l in item.findall('.//{http://www.w3.org/2005/Atom}link'):
            link = l.get('href', '')
            break
    if not link:
        link = item.findtext('id', '') or ''
    
    desc = item.findtext('description', '') or ''
    desc = re.sub(r'<[^>]+>', ' ', desc)
    desc = html.unescape(desc)
    desc = re.sub(r'\s+', ' ', desc).strip()[:400]
    
    pubdate = item.findtext('pubDate', '') or item.findtext('published', '') or item.findtext('updated', '') or ''
    try:
        if pubdate:
            dt = parsedate_to_datetime(pubdate)
        else:
            continue
    except:
        continue
    
    if dt.timestamp() < cutoff:
        continue
    
    title = html.unescape(title).strip()
    title = re.sub(r'\s+', ' ', title)
    
    if not title or len(title) < 15:
        continue
    
    if is_arxiv:
        title_lower = title.lower()
        if not any(kw in title_lower for kw in ARXIV_KW):
            continue
        # Trim arXiv IDs from title
        title = re.sub(r'\s*\(arXiv:[^)]+\)', '', title)
    
    count += 1
    # Escape pipes in title/desc for pipe-delimited format
    safe_title = title[:200].replace('|', '/')
    safe_link = link.replace('|', '%7C') if link else ''
    safe_desc = desc[:600].replace('|', '/')
    # Output: FEED|title|url|description
    print(f'{name}|{safe_title}|{safe_link}|{safe_desc}')
    
    if count >= 10:
        break

# Always print at least nothing (suppress error messages)
" 2>/dev/null >> "$RAWFILE"
  
  sleep 0.5
done

# ── Browserbase Search augmentation (optional) ──
BB_KEY="${BROWSERBASE_API_KEY:-${BROWSERBASE_API:-}}"
if [ -n "$BB_KEY" ]; then
  echo "  + Browserbase Search (supplementing RSS)"
  SEARCH_QUERIES=(
    "latest AI model release LLM launch 2026"
    "new open source AI model breakthrough"
    "AI research paper state of the art benchmark"
  )
  for query in "${SEARCH_QUERIES[@]}"; do
    curl -sf --max-time 10 \
      -X POST "https://api.browserbase.com/v1/search" \
      -H "Content-Type: application/json" \
      -H "X-BB-API-Key: ${BB_KEY}" \
      -d "{\"query\": \"$query\", \"numResults\": 5}" \
      -o "${TMPDIR}/search_$(echo "$query" | md5sum | cut -c1-8).json" 2>/dev/null || true
    sleep 0.5
  done
  
  # Convert search results to pipe-delimited format
  python3 -c "
import json, glob, os
for fpath in sorted(glob.glob('${TMPDIR}/search_*.json')):
    try:
        data = json.load(open(fpath))
    except:
        continue
    for r in data.get('results', []):
        title = (r.get('title') or '').replace('|', '/')[:200]
        url = (r.get('url') or '').replace('|', '%7C')
        desc = (r.get('author') or '')[:200]
        if title:
            print(f'Browserbase Search|{title}|{url}|{desc}')
" >> "$RAWFILE" 2>/dev/null || true
fi

# ── Clean and deduplicate ──
echo "AI_NEWS ($MODE, $(wc -l < "$RAWFILE" 2>/dev/null || echo 0) raw items)"
echo ""

/opt/data/workspace/bin/ai-news-clean < "$RAWFILE" 2>/dev/null

echo ""
echo "END_FETCH"
